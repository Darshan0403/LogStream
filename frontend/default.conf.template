server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # 1. SPA fallback — route all normal frontend navigation to React
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 2. Proxy REST API calls to the Go container.
    #    The API key is injected here so it never ships in the browser bundle (C4).
    #    Any client-supplied key is discarded and replaced.
    location /api/ {
        proxy_pass http://logstream-api:8090/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-API-Key "${LOGSTREAM_API_KEY}";
    }

    # 3. Proxy the WebSocket Live Tail connection (backend route is /ws/tail).
    location /ws/ {
        proxy_pass http://logstream-api:8090/ws/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 3600s;
    }

    # 4. Health probe passthrough (handy for uptime checks hitting the frontend).
    location = /health {
        proxy_pass http://logstream-api:8090/health;
        proxy_set_header Host $host;
    }

    # NOT proxied on purpose (M10):
    #   /ingest  — log shippers (Vector) talk to the API directly, authenticated.
    #   /metrics — Prometheus endpoint; scrape the API container directly, keep it
    #              off the public frontend.
}
