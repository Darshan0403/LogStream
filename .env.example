# Copy to .env and fill in strong values. docker-compose reads this automatically.
# The Go server refuses to start with 'dev-key' or the default DB password
# unless ALLOW_INSECURE_DEFAULTS=true.

# Postgres password (used by the postgres container and in DATABASE_URL).
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Dashboard / read+write API key. nginx injects this for the frontend.
API_KEY=change-me-to-a-long-random-string

# Optional: separate key for log shippers (Vector, `logstream collect`).
# Leave blank to reuse API_KEY.
INGEST_KEY=

# Local dev escape hatch only. Never set to true for a deployed instance.
ALLOW_INSECURE_DEFAULTS=false

# Browser origin(s) allowed to call the API / open the live tail (comma list; * for dev).
ALLOWED_ORIGINS=http://localhost:5173

# Structured logging. LOG_FORMAT=json|text, LOG_LEVEL=debug|info|warn|error.
LOG_FORMAT=json
LOG_LEVEL=info

# Optional overrides:
# INGEST_ENABLED=true         # set false for a read-only public deployment
# WS_JWT_SECRET=              # dedicated WS token secret (else derived from API_KEY)
# TRUSTED_PROXIES=            # CIDRs whose X-Forwarded-For is trusted (default: loopback+RFC1918)
# PORT=8090                   # listen port when --port isn't passed
